PORT=3000
FIREBASE_PROJECT_ID=your-firebase-project-id

# Cloud access: absolute path to a service-account JSON stored OUTSIDE this repo.
# Alternatively use Application Default Credentials from your environment.
# Never use VITE_ prefixes for server credentials.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/les-service-account.json

# Local emulator only. Uncomment ONLY when the Firestore emulator is running.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
